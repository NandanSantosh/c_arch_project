{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {}
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "OFF"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTS": "OFF"
            }
        },
        {
            "name": "test",
            "displayName": "Test",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "ON",
                "LOG_PANEL": "OFF",
                "DISABLE_GUI": "ON"
            }
        },
        {
            "name": "cli",
            "displayName": "CLI",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "OFF",
                "LOG_PANEL": "OFF",
                "DISABLE_GUI": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "cli",
            "displayName": "Build CLI",
            "configurePreset": "cli",
            "targets": [
                "kites_cli"
            ]
        },
        {
            "name": "test",
            "configurePreset": "test"
        },
        {
            "name": "test-only",
            "displayName": "Build tests (no coverage)",
            "configurePreset": "test",
            "targets": [
                "kites_test"
            ]
        },
        {
            "name": "test-coverage",
            "displayName": "Build tests (with coverage)",
            "configurePreset": "test",
            "targets": [
                "kites_test_cov"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "test",
            "configurePreset": "test",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-only",
            "displayName": "Run tests (no coverage)",
            "configurePreset": "test",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "exclude": {
                    "name": "^cov_"
                }
            }
        },
        {
            "name": "test-coverage",
            "displayName": "Run tests (with coverage)",
            "configurePreset": "test",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "include": {
                    "name": "^cov_"
                }
            }
        }
    ]
}
